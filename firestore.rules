rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to get the user's role from the 'users' collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Function to check specific roles
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'SuperAdmin';
    }
    
    function isRegionalAdmin() {
      return isAuthenticated() && getUserRole() == 'RegionalAdmin';
    }
    
    function isResponder() {
      return isAuthenticated() && getUserRole() == 'Responder';
    }
    
    function isAdmin() {
      return isSuperAdmin() || isRegionalAdmin();
    }

    // Users Collection
    // Anyone can create their initial profile (handled by Auth triggers or client).
    // Users can read and update their own profiles.
    // Admins can read all profiles and update roles.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSuperAdmin();
    }

    // Reports Collection
    // Authenticated users can read and create reports.
    // Only Responders and Admins can update reports (verifying, resolving).
    // Only Admins can delete reports.
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isResponder() || isAdmin();
      allow delete: if isAdmin();
    }

    // Funds Collections
    // Everyone can read for transparency.
    // Only Admins can modify.
    match /fund_inflows/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /fund_outflows/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /fund_requests/{document=**} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Emergency Alerts & Shelters
    // Everyone can read. Only Admins can modify.
    match /alerts/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /shelters/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Telemetry & Audit Logs
    // Anyone can read (for transparency dashboard).
    // Anyone authenticated can create an audit log (via client side telemetryService).
    // NO ONE can update or delete audit logs (append-only log).
    match /audit_logs/{document=**} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    match /ai_logs/{document=**} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    match /predictions/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Assuming client runs prediction engine
    }
  }
}
